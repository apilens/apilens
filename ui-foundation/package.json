{
  "name": "@apilens/ui-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Aperture: the APILens UI foundation (tokens, primitives, patterns) and the AI-agent rules that keep it consistent.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ui:check": "node scripts/ui-guard.mjs",
    "ui:contrast": "node scripts/check-contrast.mjs",
    "check": "pnpm ui:check && pnpm ui:contrast && node scripts/sync-design-md.mjs --check && pnpm typecheck && pnpm lint",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "design:sync": "node scripts/sync-design-md.mjs",
    "design:lint": "design.md lint DESIGN.md"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
