{{template "layout" .}}
{{- define "content" -}}
<p style="margin:0 0 16px 0;"><strong>{{.actor}}</strong> deleted the project <strong>{{.project}}</strong>. Ingest for it is rejected from now on, and its data is removed for good on {{datetime .purge_at}}.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Project</td><td style="padding:2px 0;">{{.project}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Deleted by</td><td style="padding:2px 0;">{{.actor}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Time</td><td style="padding:2px 0;">{{datetime .time}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Removed for good</td><td style="padding:2px 0;">{{datetime .purge_at}}</td></tr>
</table>
<p style="margin:0 0 24px 0;">Until then, any admin of the project can restore it from Project settings, Danger zone.</p>
<p style="margin:0 0 24px 0;"><a class="button" href="{{link (print "/" (seg .slug) "/settings/danger")}}" style="display:inline-block;padding:10px 20px;border-radius:6px;background:#5b4bff;color:#ffffff;font-weight:600;text-decoration:none;">Restore the project</a></p>
<p class="muted" style="margin:0;color:#556070;">You get this email because you are an admin of {{.project}}. Deletion emails are always sent.</p>
{{- end}}
