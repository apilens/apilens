{{template "layout" .}}
{{- define "content" -}}
<p style="margin:0 0 16px 0;"><strong>{{.app}} ({{.environment}})</strong> is down: it has sent no heartbeat for over {{.down_after}}.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">App</td><td style="padding:2px 0;">{{.app}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Environment</td><td style="padding:2px 0;">{{.environment}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Check</td><td style="padding:2px 0;">Heartbeat</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Last heartbeat</td><td style="padding:2px 0;">{{datetime .last_heartbeat}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Down after</td><td style="padding:2px 0;">{{.down_after}} without a heartbeat</td></tr>
</table>
<p style="margin:0 0 24px 0;"><a class="button" href="{{link (print "/" (seg .project) "/incidents") "event" .event}}" style="display:inline-block;padding:10px 20px;border-radius:6px;background:#5b4bff;color:#ffffff;font-weight:600;text-decoration:none;">View incident</a></p>
<p class="muted" style="margin:0;color:#556070;">You get this email because this address is on a notification channel of the project.</p>
{{- end}}
