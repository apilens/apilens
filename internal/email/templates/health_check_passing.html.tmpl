{{template "layout" .}}
{{- define "content" -}}
<p style="margin:0 0 16px 0;">The health check of <strong>{{.app}} ({{.environment}})</strong> is passing again: GET {{.check}} answers {{.expected_status}}.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">App</td><td style="padding:2px 0;">{{.app}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Environment</td><td style="padding:2px 0;">{{.environment}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Check</td><td style="padding:2px 0;">GET {{.check}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Failing since</td><td style="padding:2px 0;">{{datetime .started_at}}</td></tr>
<tr><td class="muted" style="padding:2px 16px 2px 0;color:#556070;">Passing again</td><td style="padding:2px 0;">{{datetime .ended_at}}</td></tr>
</table>
<p style="margin:0 0 24px 0;"><a class="button" href="{{link (print "/" (seg .project) "/settings/health-checks")}}" style="display:inline-block;padding:10px 20px;border-radius:6px;background:#5b4bff;color:#ffffff;font-weight:600;text-decoration:none;">View health check</a></p>
<p class="muted" style="margin:0;color:#556070;">You get this email because this address is on a notification channel of the project.</p>
{{- end}}
