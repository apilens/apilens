{{template "layout" .}}
{{- define "content" -}}
<p style="margin:0 0 16px 0;">Enter this code in APILens to make this your account's email address:</p>
<p class="code" style="margin:0 0 24px 0;padding:12px 16px;border-radius:6px;background:#f2f2f5;color:#0d1117;text-align:center;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:28px;font-weight:700;letter-spacing:0.2em;">{{.code}}</p>
<p class="muted" style="margin:0 0 8px 0;color:#556070;">The code expires in {{.expires_in}} and works once.</p>
<p class="muted" style="margin:0;color:#556070;">If you did not ask to change your APILens email address, ignore this email. The address is not added without the code.</p>
{{- end}}
