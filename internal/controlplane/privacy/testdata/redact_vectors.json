      "op": "raw_path",
      "in": "/a?page=2&api_key=k1&apikey=k2&API-KEY=k3&x=1",
      "want": "/a?page=2&api_key=[redacted]&apikey=[redacted]&API-KEY=[redacted]&x=1"
    },
    {
      "name": "auth-like names",
      "policy": {
        "mask_query_params": [],
