# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum,go.work}]
indent_style = tab

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.{java,kt}]
indent_size = 4

[*.proto]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
