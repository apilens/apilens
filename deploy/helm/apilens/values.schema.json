{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APILens Helm chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "role": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "type": "array" },
    "roles": {
      "type": "object",
      "description": "One Deployment per enabled role. Implemented: all, edge, identity, api. Others are reserved for upcoming releases.",
      "propertyNames": {
        "enum": ["all", "edge", "writer", "processor", "query", "api", "identity", "saml", "worker", "mcp"]
      },
      "additionalProperties": { "$ref": "#/definitions/role" }
    },
    "config": {
      "type": "object",
      "description": "Extra APILENS_* environment variables.",
      "propertyNames": { "pattern": "^APILENS_[A-Z0-9_]+$" },
      "properties": {
        "APILENS_AUDIT__RETENTION": { "type": "integer", "description": "audit.retention: days audit events are kept; at least 30, or 0 to keep them forever.", "anyOf": [{ "const": 0 }, { "minimum": 30 }] },
        "APILENS_IDENTITY__SENSITIVE_ACTION_MAX_AGE": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$|^0$", "description": "identity.sensitive_action_max_age: how old a sign-in may be for sensitive actions (Go duration, > 0)." },
        "APILENS_PROJECT__DELETION_GRACE": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$|^0$", "description": "project.deletion_grace: restore window of a deleted project (Go duration; 0s = none)." },
        "APILENS_ACCESS__MAX_DIRECT_MEMBERS_PER_PROJECT": { "type": "integer", "minimum": 0, "description": "access.max_direct_members_per_project: people added to one project directly; 0 = no limit." },
        "APILENS_INGEST__MAX_KEYS_PER_PROJECT": { "type": "integer", "minimum": 0, "description": "ingest.max_keys_per_project: active API keys per project; 0 = no limit." },
        "APILENS_INGEST__RECORD_KEY_IP": { "type": "boolean", "description": "ingest.record_key_ip: record the client IP of an API key's last ingest request." },
        "APILENS_RETENTION__REQUESTS": { "type": "integer", "minimum": 1, "maximum": 3650, "description": "retention.requests: days requests are kept." },
        "APILENS_RETENTION__LOGS": { "type": "integer", "minimum": 1, "maximum": 3650, "description": "retention.logs: days logs are kept." },
        "APILENS_RETENTION__SPANS": { "type": "integer", "minimum": 1, "maximum": 3650, "description": "retention.spans: days spans are kept." },
        "APILENS_RETENTION__ROLLUPS_1M": { "type": "integer", "minimum": 1, "maximum": 400, "description": "retention.rollups_1m: days per-minute rollups are kept." },
        "APILENS_RETENTION__ROLLUPS_1H": { "type": "integer", "minimum": 30, "maximum": 3650, "description": "retention.rollups_1h: days per-hour rollups are kept." }
      },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "externalPostgres": {
      "type": "object",
      "properties": { "maxConns": { "type": "integer", "minimum": 1 } }
    },
    "externalClickHouse": {
      "type": "object",
      "required": ["addr", "database", "username"],
      "properties": {
        "addr": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "secure": { "type": "boolean" },
        "cluster": { "type": "string" }
      }
    },
    "externalValkey": {
      "type": "object",
      "properties": {
        "addr": { "type": "array", "items": { "type": "string" } },
        "username": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "postgresUrl": { "type": "string" },
        "clickhousePassword": { "type": "string" },
        "valkeyPassword": { "type": "string" },
        "sessionSecret": { "type": "string" },
        "identityKeyEncryptionKey": { "type": "string" },
        "smtpPassword": { "type": "string" },
        "oauthGoogleClientSecret": { "type": "string" },
        "oauthGithubClientSecret": { "type": "string" },
        "spicedbPresharedKey": { "type": "string" },
        "spicedbDatastoreUri": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "issuer": { "type": "string", "pattern": "^(https?://.+)?$" },
        "publicUiUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
        "cookieDomain": { "type": "string" },
        "webauthn": {
          "type": "object",
          "properties": {
            "rpId": { "type": "string", "pattern": "^[^:/]*$" },
            "rpName": { "type": "string" },
            "origins": { "type": "array", "items": { "type": "string", "pattern": "^https?://.+" } }
          },
          "additionalProperties": false
        },
        "corsOrigins": { "type": "array", "items": { "type": "string", "pattern": "^https?://.+" } },
        "trustedProxies": { "type": "array", "items": { "type": "string" } },
        "oauth": {
          "type": "object",
          "properties": {
            "google": {
              "type": "object",
              "properties": { "clientId": { "type": "string" } },
              "additionalProperties": false
            },
            "github": {
              "type": "object",
              "properties": { "clientId": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "email": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["log", "smtp"] },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string" },
        "from": { "type": "string" },
        "replyTo": { "type": "string" },
        "tls": { "type": "string", "enum": ["starttls", "tls", "none"] },
        "timeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" }
      },
      "additionalProperties": false
    },
    "authz": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "External SpiceDB gRPC address (host:port). Empty disables authz unless spicedb.enabled.",
          "pattern": "^([^:]+:[0-9]+)?$"
        },
        "insecure": { "type": "boolean" },
        "cacheTTL": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$|^0$" }
      },
      "additionalProperties": false
    },
    "spicedb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "type": "array" }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "service": { "type": "object" },
        "resources": { "$ref": "#/definitions/resources" },
        "apiUrl": { "type": "string" },
        "publicUrl": { "type": "string" },
        "extraEnv": { "type": "array" }
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "type": "array" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "webHost": { "type": "string" },
        "ingestHost": { "type": "string" },
        "ingestRole": { "type": "string" },
        "tls": { "type": "array" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "topologySpreadConstraints": { "type": "array" },
    "defaultTopologySpread": { "type": "boolean" },
    "metrics": {
      "type": "object",
      "properties": { "podAnnotations": { "type": "boolean" } }
    }
  },
  "required": ["image", "roles", "externalClickHouse"]
}
