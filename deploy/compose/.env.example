# APILens self-host settings. Copy to `.env` next to compose.yaml and fill in.
# Generate secrets with:  openssl rand -hex 32
# Use hex (URL-safe) values: the Postgres password is embedded in a URL.

# Image tag for ghcr.io/apilens/{apilens,web}. `edge` tracks the v2 branch.
APILENS_VERSION=edge

# --- Required secrets -------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
VALKEY_PASSWORD=change-me-valkey
# Encrypts the dashboard (`web`) session cookie (at least 32 characters).
# Rotating it signs everyone out.
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Identity key encryption key: 32 random bytes, base64. Encrypts token signing
# keys and TOTP secrets at rest; the identity role refuses to start without it.
# Generate with:  openssl rand -base64 32
# Losing or changing it makes stored signing keys and TOTP secrets unreadable.
APILENS_IDENTITY__KEY_ENCRYPTION_KEY=
# SpiceDB preshared key: APILens authenticates to SpiceDB with it.
SPICEDB_PRESHARED_KEY=change-me-spicedb

# --- Optional ---------------------------------------------------------------
# Public URL users open the dashboard at (behind your TLS proxy in production).
# Also the default WebAuthn origin and identity.public_ui_url (email links).
APILENS_PUBLIC_URL=http://localhost:3000
# Public URL of the API port (8080) that SDKs and OpenTelemetry exporters send
# events to; the dashboard uses it in onboarding and API key setup snippets.
APILENS_PUBLIC_INGEST_URL=http://localhost:8080
# --- Identity (APILENS_IDENTITY__* -> identity.* in the binary's config) ---
# Token issuer (`iss`): the public URL of the APILens API.
APILENS_IDENTITY__ISSUER=http://localhost:8080
# Session cookie domain; empty = host-only. Set e.g. `example.com` to share
# the session across subdomains.
APILENS_IDENTITY__COOKIE_DOMAIN=
# Token and code lifetimes (Go durations).
APILENS_IDENTITY__ACCESS_TOKEN_TTL=15m
APILENS_IDENTITY__REFRESH_TOKEN_TTL=720h
# Refresh lifetime when "remember me" is off.
APILENS_IDENTITY__REFRESH_TOKEN_TTL_SHORT=24h
APILENS_IDENTITY__EMAIL_CODE_TTL=15m
APILENS_IDENTITY__EMAIL_CODE_MAX_ATTEMPTS=5
# Window between the first factor and the MFA step.
APILENS_IDENTITY__PRE_AUTH_TTL=5m
# Cooling-off period before a lost-2FA account recovery can be confirmed.
APILENS_IDENTITY__RECOVERY_DELAY=24h
# WebAuthn relying party. RP ID is the registrable domain users see (no
# scheme or port). Origins (comma-separated) default to APILENS_PUBLIC_URL.
APILENS_IDENTITY__WEBAUTHN__RP_ID=localhost
APILENS_IDENTITY__WEBAUTHN__RP_NAME=APILens
# APILENS_IDENTITY__WEBAUTHN__ORIGINS=https://apilens.example.com
# identity.public_ui_url (email links, OAuth redirects) follows APILENS_PUBLIC_URL.
# Browser origins allowed to call /api/v1/auth/* cross-origin (comma-separated).
# Leave empty: the dashboard calls identity server-side, so no CORS is needed.
APILENS_IDENTITY__CORS_ORIGINS=
# Social sign-in (optional; see deploy/README.md "OAuth sign-in"). A provider
# is enabled when its client ID is set, and then needs its secret too.
# Redirect URI: ${APILENS_IDENTITY__ISSUER}/api/v1/auth/oauth/{google|github}/callback
APILENS_IDENTITY__OAUTH__GOOGLE__CLIENT_ID=
APILENS_IDENTITY__OAUTH__GOOGLE__CLIENT_SECRET=
APILENS_IDENTITY__OAUTH__GITHUB__CLIENT_ID=
APILENS_IDENTITY__OAUTH__GITHUB__CLIENT_SECRET=
# Auth rate limits (shared in Valkey; 429 + Retry-After, 503 if Valkey is down).
# Each limit has __LIMIT and __WINDOW; defaults shown for two of them.
# APILENS_IDENTITY__RATE_LIMITS__EMAIL_START_PER_EMAIL__LIMIT=5
# APILENS_IDENTITY__RATE_LIMITS__EMAIL_START_PER_EMAIL__WINDOW=15m
# Others: EMAIL_START_PER_IP (20/15m), CODE_VERIFY_PER_EMAIL (10/15m),
# REFRESH_PER_IP (60/1m), SECOND_FACTOR_PER_USER (10/15m),
# OAUTH_START_PER_IP (30/15m), HANDOFF_PER_IP (30/15m), SSO_LOOKUP_PER_IP (60/15m),
# SLUG_CHECK_PER_USER (60/1m).
# RECOVERY_REQUEST_PER_EMAIL (3/1h), RECOVERY_PER_IP (20/15m).
# Reverse proxies (IPs/CIDRs, comma-separated) whose X-Forwarded-For is
# trusted for the client IP; empty = use the TCP peer.
# APILENS_IDENTITY__RATE_LIMITS__TRUSTED_PROXIES=172.16.0.0/12

# --- Authorization (APILENS_AUTHZ__* -> authz.* in the binary's config) ----
# The compose file points authz.endpoint at the bundled SpiceDB
# (spicedb:50051, plaintext on the compose network) and authz.preshared_key at
# SPICEDB_PRESHARED_KEY. How long a permission check result may be reused
# (0s disables the client-side cache):
APILENS_AUTHZ__CACHE_TTL=5s

# --- Email (APILENS_EMAIL__* -> email.* in the binary's config) -------------
# Sign-in codes, invitations and security alerts. `log` (the default) writes
# each message to the apilens log instead of sending it, and warns at startup.
# Set `smtp` plus HOST and FROM to deliver mail.
APILENS_EMAIL__PROVIDER=log
APILENS_EMAIL__HOST=
APILENS_EMAIL__PORT=587
APILENS_EMAIL__USERNAME=
APILENS_EMAIL__PASSWORD=
# Sender, e.g. `APILens <no-reply@example.com>`. Required for smtp.
APILENS_EMAIL__FROM=
APILENS_EMAIL__REPLY_TO=
# starttls (port 587) | tls (implicit, port 465) | none (local relays only)
APILENS_EMAIL__TLS=starttls
APILENS_EMAIL__TIMEOUT=10s

# --- Project access, lifecycle and audit ------------------------------------
# How old a sign-in may be for sensitive actions (delete or restore a project,
# rename its slug, change access, create or rotate an API key); older sessions
# are asked to sign in again (Go duration).
APILENS_IDENTITY__SENSITIVE_ACTION_MAX_AGE=10m
# How long a deleted project can be restored before its data is purged
# (Go duration; 168h = 7 days, 0 = purge at the next run).
APILENS_PROJECT__DELETION_GRACE=168h
# People who can be added to one project directly (0 = no limit).
APILENS_ACCESS__MAX_DIRECT_MEMBERS_PER_PROJECT=500
# Active API keys per project (0 = no limit).
APILENS_INGEST__MAX_KEYS_PER_PROJECT=50
# Record the client IP of each API key's last ingest request (personal data,
# for access reviews). false stops recording and clears it on next use.
APILENS_INGEST__RECORD_KEY_IP=true
# Days audit events are kept: at least 30, or 0 to keep them forever.
APILENS_AUDIT__RETENTION=400

# --- Telemetry retention (APILENS_RETENTION__* -> retention.*), in days -----
# `migrate` applies these to the ClickHouse table TTLs on every `up`. Shortening
# a period deletes older data and stops `migrate` until you run it once with
# -confirm-retention-change:
#   docker compose run --rm migrate migrate -confirm-retention-change
APILENS_RETENTION__REQUESTS=90
APILENS_RETENTION__LOGS=30
APILENS_RETENTION__SPANS=30
# Per-minute rollups (1 to 400 days) and per-hour rollups (30 to 3650 days).
APILENS_RETENTION__ROLLUPS_1M=30
APILENS_RETENTION__ROLLUPS_1H=400

# Host ports
APILENS_INGEST_PORT=8080
APILENS_WEB_PORT=3000
# debug | info | warn | error
APILENS_LOG_LEVEL=info
# Send APILens's own traces to an OTLP/HTTP endpoint (empty = disabled).
APILENS_OTEL_ENDPOINT=
# Container memory limits
APILENS_MEMORY_LIMIT=1g
CLICKHOUSE_MEMORY_LIMIT=4g
POSTGRES_MEMORY_LIMIT=1g
VALKEY_MEMORY_LIMIT=256m
SPICEDB_MEMORY_LIMIT=512m
WEB_MEMORY_LIMIT=512m

