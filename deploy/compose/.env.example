# APILens self-host settings. Copy to `.env` next to compose.yaml and fill in.
# Generate secrets with:  openssl rand -hex 32
# Use hex (URL-safe) values: the Postgres password is embedded in a URL.

# Image tag for ghcr.io/apilens/{apilens,web}. `edge` tracks the v2 branch.
APILENS_VERSION=edge

# --- Required secrets -------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
VALKEY_PASSWORD=change-me-valkey
# Encrypts the dashboard session cookie (at least 32 characters).
SESSION_SECRET=change-me-session-secret-at-least-32-chars

# --- Optional ---------------------------------------------------------------
# Host ports
APILENS_INGEST_PORT=8080
APILENS_WEB_PORT=3000
# debug | info | warn | error
APILENS_LOG_LEVEL=info
# Send APILens's own traces to an OTLP/HTTP endpoint (empty = disabled).
APILENS_OTEL_ENDPOINT=
# Container memory limits
APILENS_MEMORY_LIMIT=1g
CLICKHOUSE_MEMORY_LIMIT=4g
POSTGRES_MEMORY_LIMIT=1g
VALKEY_MEMORY_LIMIT=256m
WEB_MEMORY_LIMIT=512m

# Console (v2 dashboard). Create the key with:
#   docker compose run --rm --entrypoint /apilens apilens seed
# and paste its `read_key` here, then `docker compose up -d console`.
APILENS_READ_KEY=
APILENS_CONSOLE_PORT=3100
# URL your apps use to reach the edge (shown on the console Setup page).
APILENS_PUBLIC_INGEST_URL=http://localhost:8080
CONSOLE_MEMORY_LIMIT=384m
