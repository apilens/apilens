# APILens self-host settings. Copy to `.env` next to compose.yaml and fill in.
# Generate secrets with:  openssl rand -hex 32
# Use hex (URL-safe) values: the Postgres password is embedded in a URL.

# Image tag for ghcr.io/apilens/{apilens,web}. `edge` tracks the v2 branch.
APILENS_VERSION=edge

# --- Required secrets -------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
VALKEY_PASSWORD=change-me-valkey
# Encrypts the dashboard session cookie (at least 32 characters).
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Identity key encryption key: 32 random bytes, base64. Encrypts token signing
# keys and TOTP secrets at rest; the identity role refuses to start without it.
# Generate with:  openssl rand -base64 32
# Losing or changing it makes stored signing keys and TOTP secrets unreadable.
APILENS_IDENTITY__KEY_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------
# Public URL users open the dashboard at (behind your TLS proxy in production).
APILENS_PUBLIC_URL=http://localhost:3000
# --- Identity (APILENS_IDENTITY__* -> identity.* in the binary's config) ---
# Token issuer (`iss`): the public URL of the APILens API.
APILENS_IDENTITY__ISSUER=http://localhost:8080
# Session cookie domain; empty = host-only. Set e.g. `example.com` to share
# the session across subdomains.
APILENS_IDENTITY__COOKIE_DOMAIN=
# Token and code lifetimes (Go durations).
APILENS_IDENTITY__ACCESS_TOKEN_TTL=15m
APILENS_IDENTITY__REFRESH_TOKEN_TTL=720h
# Refresh lifetime when "remember me" is off.
APILENS_IDENTITY__REFRESH_TOKEN_TTL_SHORT=24h
APILENS_IDENTITY__EMAIL_CODE_TTL=15m
APILENS_IDENTITY__EMAIL_CODE_MAX_ATTEMPTS=5
# Window between the first factor and the MFA step.
APILENS_IDENTITY__PRE_AUTH_TTL=5m
# WebAuthn relying party. RP ID is the registrable domain users see (no
# scheme or port). Origins (comma-separated) default to APILENS_PUBLIC_URL.
APILENS_IDENTITY__WEBAUTHN__RP_ID=localhost
APILENS_IDENTITY__WEBAUTHN__RP_NAME=APILens
# APILENS_IDENTITY__WEBAUTHN__ORIGINS=https://apilens.example.com
# identity.public_ui_url (email links, OAuth redirects) follows APILENS_PUBLIC_URL.
# Browser origins allowed to call /api/v1/auth/* cross-origin (comma-separated).
# Leave empty: the dashboard calls identity server-side, so no CORS is needed.
APILENS_IDENTITY__CORS_ORIGINS=

# Host ports
APILENS_INGEST_PORT=8080
APILENS_WEB_PORT=3000
# debug | info | warn | error
APILENS_LOG_LEVEL=info
# Send APILens's own traces to an OTLP/HTTP endpoint (empty = disabled).
APILENS_OTEL_ENDPOINT=
# Container memory limits
APILENS_MEMORY_LIMIT=1g
CLICKHOUSE_MEMORY_LIMIT=4g
POSTGRES_MEMORY_LIMIT=1g
VALKEY_MEMORY_LIMIT=256m
WEB_MEMORY_LIMIT=512m

