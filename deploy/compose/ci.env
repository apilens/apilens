# Fixed, throwaway secrets for CI end-to-end runs ONLY. Never use in production.
#   docker compose --env-file deploy/compose/ci.env \
#     -f deploy/compose/compose.yaml -f deploy/compose/compose.ci.yaml up -d --build --wait
APILENS_VERSION=ci
POSTGRES_PASSWORD=ci-postgres
