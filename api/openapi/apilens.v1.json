  "info": {
    "description": "Dashboard and management API for APILens. Ingest endpoints (/v1/*, /otlp/v1/*) are documented separately.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "APILens API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/oauth/{provider}/start": {
      "get": {
        "description": "Public browser navigation. Starts an authorization-code flow with PKCE (and an OIDC nonce for Google), keeps the attempt server-side for 10 minutes keyed by a random state, and redirects (302) to the provider. Rate-limited per client IP. A provider that is not configured answers 404.",
        "operationId": "start-oauth",
        "parameters": [
          {
            "description": "Social sign-in provider.",
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "description": "Social sign-in provider.",
              "enum": [
                "google",
                "github"
              ],
              "type": "string"
            }
          },
          {
            "description": "Relative path (starting with a single /) to open after sign-in. Defaults to /.",
            "explode": false,
            "in": "query",
            "name": "next",
            "schema": {
              "description": "Relative path (starting with a single /) to open after sign-in. Defaults to /.",
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "description": "login signs in or up; link attaches the provider to the signed-in user.",
            "explode": false,
            "in": "query",
            "name": "intent",
            "schema": {
              "default": "login",
              "description": "login signs in or up; link attaches the provider to the signed-in user.",
              "enum": [
                "login",
                "link"
              ],
              "type": "string"
            }
          },
          {
            "description": "Keep the session for the long refresh-token lifetime.",
            "explode": false,
            "in": "query",
            "name": "remember",
            "schema": {
              "description": "Keep the session for the long refresh-token lifetime.",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Found",
            "headers": {
              "Location": {
                "schema": {
                  "description": "The provider's authorization URL.",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request. Codes: `invalid_request`.",
            "x-apilens-codes": [
              "invalid_request"
            ]
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized. Codes: `unauthenticated`.",
            "x-apilens-codes": [
              "unauthenticated"
            ]
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests. Codes: `rate_limited`.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying; mirrors `retry_after`.",
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            },
            "x-apilens-codes": [
              "rate_limited"
            ]
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error. Codes: `internal_error`.",
            "x-apilens-codes": [
              "internal_error"
            ]
          }
        },
        "summary": "Start social sign-in",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/providers": {
      "get": {
        "description": "Public. Lists which sign-in methods this deployment offers so the sign-in page shows only working buttons.",
