                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "readKey": []
          }
        ],
        "summary": "Project, apps and environments of the read key",
        "tags": [
          "Dashboard"
        ]
      }
    },
    "/api/v1/requests": {
      "get": {
        "operationId": "list-requests",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "status",
            "schema": {
              "default": "all",
              "enum": [
                "all",
                "2xx",
                "3xx",
                "4xx",
                "5xx"
              ],
              "type": "string"
            }
          },
          {
            "description": "Route template, e.g. /orders/{id}.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Route template, e.g. /orders/{id}.",
              "maxLength": 1024,
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "format": "int64",
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "readKey": []
          }
        ],
        "summary": "Most recent requests",
        "tags": [
          "Dashboard"
        ]
      }
    },
    "/api/v1/traces/{trace_id}": {
      "get": {
        "operationId": "get-trace",
        "parameters": [
          {
            "description": "W3C trace id (32 lowercase hex characters).",
            "in": "path",
            "name": "trace_id",
            "required": true,
            "schema": {
              "description": "W3C trace id (32 lowercase hex characters).",
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
