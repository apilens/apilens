  "info": {
    "description": "Dashboard and management API for APILens. Ingest endpoints (/v1/*, /otlp/v1/*) are documented separately.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "APILens API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/deploys": {
      "get": {
        "operationId": "list-deploys",
        "parameters": [
          {
            "description": "Time range ending now.",
            "explode": false,
            "in": "query",
            "name": "range",
            "schema": {
              "default": "24h",
              "description": "Time range ending now.",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Environment name; empty means all.",
            "explode": false,
            "in": "query",
            "name": "env",
            "schema": {
              "description": "Environment name; empty means all.",
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploysOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "readKey": []
          }
        ],
        "summary": "Deploy markers in a time range",
        "tags": [
          "Dashboard"
        ]
      }
    },
    "/api/v1/errors": {
      "get": {
        "operationId": "list-errors",
        "parameters": [
          {
            "description": "Time range ending now.",
            "explode": false,
            "in": "query",
            "name": "range",
            "schema": {
              "default": "24h",
              "description": "Time range ending now.",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Environment name; empty means all.",
            "explode": false,
            "in": "query",
            "name": "env",
            "schema": {
              "description": "Environment name; empty means all.",
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "readKey": []
          }
        ],
        "summary": "Failed requests grouped by endpoint and status",
        "tags": [
          "Dashboard"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "get-meta",
