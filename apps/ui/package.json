{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "description": "APILens UI: Next.js app built on the APILens design system (tokens.json + bundle.css)",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fake": "playwright test -c playwright.fake.config.ts",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@playwright/test": "~1.64.1",
    "@types/node": "^22.13.10",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "otplib": "^13.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
