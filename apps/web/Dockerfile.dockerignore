# Dockerfile-specific ignore (BuildKit reads <Dockerfile>.dockerignore next to
# the Dockerfile). Context is the repo root; send only what the web image needs.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/web/**
apps/web/node_modules
apps/web/.next
apps/web/*.png
apps/web/tsconfig.tsbuildinfo
