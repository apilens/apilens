# Keep patterns anchored and specific: a bare `log/` or `migrations/` once
# silently hid real source directories.

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Secrets and local env (examples are committed)
.env
.env.*
!.env.example
!deploy/compose/ci.env

# Go
/bin/
/dist/
/tmp/
/coverage.out
*.test
*.prof

# Node / Next.js / Turborepo
node_modules/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts
packages/sdk-typescript/dist/
.pnpm-store/

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
packages/sdk-python/dist/
packages/sdk-python/build/

# Java SDK
packages/sdk-java/target/

# Helm
deploy/helm/**/charts/*.tgz

# Local agent / tool state
.claude/settings.local.json
.playwright-mcp/
playwright-report/
test-results/

# go-task checksum cache
.task/
