// SpiceDB schema for APILens (ADR 0006).
//
// Postgres is the source of truth; relationships reach SpiceDB through the
// outbox relay. Roles are relations, actions are permissions. The role → action
// mapping is documented in authz/README.md and asserted in
// authz/schema.validation.yaml (`task lint:authz`).

/** user is a signed-in human; agents act on a user's behalf (RFC 8693). */
definition user {}

/** organization owns projects and grants roles across all of them. */
definition organization {
	relation owner: user
	relation admin: user
	relation member: user
	relation viewer: user

	/** manage: org settings and project deletion (owner, admin). */
	permission manage = owner + admin

	/** manage_members: change roles and remove members (members.remove). */
	permission manage_members = manage

	/** invite: send invitations (members.invite). */
	permission invite = manage

	/** manage_billing: plans and invoices (billing.manage); owners only. */
	permission manage_billing = owner

	/** create_project: everyone who can write to projects in the org. */
	permission create_project = member + manage

	/** view: see the org and every project in it. */
	permission view = viewer + create_project
}

/**
 * project belongs to exactly one organization. Org owners and admins are
 * always Admin (org->manage). What the rest of the org gets comes from the
 * project's default access (ADR 0009), written as the default_* relations:
 *
 *   org_role  default_editor@organization:<org>#member
 *             default_viewer@organization:<org>#viewer
 *   viewer    default_viewer@organization:<org>#member
 *             default_viewer@organization:<org>#viewer
 *   none      no default relations (restricted project)
 *
 * The optional direct roles grant access to a single project (sharing).
 * Highest grant wins.
 */
definition project {
	relation org: organization
	relation admin: user
	relation editor: user
	relation viewer: user

	/** default_editor: org members who edit this project through its default access. */
	relation default_editor: organization#member

	/** default_viewer: org members and viewers who view this project through its default access. */
	relation default_viewer: organization#member | organization#viewer

	/** delete: project.delete. */
	permission delete = admin + org->manage

	/** manage_keys: api_keys.create, api_keys.revoke. */
	permission manage_keys = admin + editor + default_editor + org->manage

	/** manage_capture: change an app's remote capture policy (project admins, org owners and admins). */
	permission manage_capture = admin + org->manage

	/** manage_alerts: create, change and delete alert rules and notification channels, send test notifications (project admins, org owners and admins). */
	permission manage_alerts = admin + org->manage

	/** manage_access: grant, change and remove project roles and change the default access (project admins, org owners and admins). */
	permission manage_access = admin + org->manage

	/** view_audit: read the project's activity log (project admins, org owners and admins). */
	permission view_audit = admin + org->manage

	/** edit: project.update. */
	permission edit = admin + editor + default_editor + org->manage

	/** view: project.read. */
	permission view = viewer + default_viewer + edit
}
